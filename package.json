{
  "name": "kakao-ai-top100-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch scripts/dev.ts",
    "chat": "node --env-file-if-exists=.env.local --import tsx scripts/chat.ts",
    "verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.10.5",
    "hono": "^4.13.14",
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
